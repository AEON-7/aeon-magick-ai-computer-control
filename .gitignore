# Build artifacts
target/
node_modules/
.svelte-kit/
build/
*.tsbuildinfo

# Cross-build outputs — regenerated by scripts/build-binaries.sh + build-web.sh.
# Do NOT commit: they go stale the moment source changes and bloat history.
image-builder/stage-aeon/01-base/files/bin/aeon-*
image-builder/stage-aeon/01-base/files/web/

# Local pi-gen artifacts (not part of this repo)
pi-gen/

# Editor + OS
.DS_Store
*.swp
*.bak
.vscode/
.idea/

# Logs
*.log

# Secrets / personal device state
.env
.env.local
auth.toml
tokens.toml
usb-serial.state
persona.state
# Hand-dropped secrets that must NEVER be committed:
#   aeon-setup.toml — first-boot WiFi PSK + Tailscale auth key
#   *.nmconnection  — NetworkManager profiles embed WiFi PSKs
#   vpn-secrets/    — provider WireGuard keys / account numbers
aeon-setup.toml
cert.pem
key.pem
*.ovpn
*.nmconnection
vpn-secrets/
__pycache__/
