[Unit]
Description=Aeon Cursed KVM — HTTPS supervisor / web UI
After=network-online.target acursed-streamer.service acursed-hid.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/acursed-supervisor --config /etc/acursed/supervisor.toml
Restart=on-failure
RestartSec=2
# Bind 443 needs root or CAP_NET_BIND_SERVICE.
User=root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
