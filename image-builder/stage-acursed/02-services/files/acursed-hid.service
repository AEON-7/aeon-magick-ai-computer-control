[Unit]
Description=Aeon Cursed KVM — USB HID gadget + input API
After=local-fs.target
# We need configfs mounted and the UDC available.
ConditionPathExistsGlob=/sys/class/udc/*

[Service]
Type=simple
ExecStart=/usr/local/bin/acursed-hid --config /etc/acursed/hid.toml
ExecStopPost=/usr/local/bin/acursed-hid --config /etc/acursed/hid.toml --teardown
Restart=on-failure
RestartSec=2
# ConfigFS writes require root.
User=root

[Install]
WantedBy=multi-user.target
