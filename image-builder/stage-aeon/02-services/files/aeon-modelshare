#!/usr/bin/env python3
"""aeon-modelshare — fleet-free Model Share discovery over IPFS.

Every Orb gossips its shared-model catalog on a well-known libp2p pubsub topic
and merges every other Orb's announcement into a local registry, so any Orb on
the IPFS network converges on the SAME global model index with NO shared token,
NO fleet enrollment, and no central server. The supervisor reads the registry
for the Model Share console; this daemon just keeps it fresh.

Three loops (threads), all driving the `aeon-ipfs` infra script so it runs the
kubo CLI as the ipfs service user:
  * SUB: `aeon-ipfs sub <topic>` streams peer announcements → merge into
    registry.json keyed by PeerID, each with a last-seen timestamp; entries
    older than PEER_TTL are pruned so orbs that go away drop off the index.
  * PUB: every ANNOUNCE_EVERY seconds (or immediately when the supervisor
    touches /run/aeon/modelshare-announce after a share/unshare) publish this
    Orb's {peer_id, label, addrs, models[]} to the topic.
  * DHT: periodically `routing findprovs` a well-known rendezvous CID that
    every Magick Orb pins. That returns live Orb PeerIDs on the Amino DHT;
    we `swarm connect /p2p/<id>` (direct, hole-punch, or circuit-relay) so
    floodsub actually has a mesh. Without this, two NATed strangers both
    "on IPFS" never see each other's catalogs.

The announcement is plain JSON. It carries only public content (CIDs +
already-public model-card metadata); the weights themselves move over the
normal IPFS swarm when a peer pins the CID.
"""
import json
import os
import socket
import subprocess
import sys
import threading
import time

TOPIC = "aeon-model-share/v1"
SCRIPT = "/usr/local/bin/aeon-ipfs"
MODELS_DIR = "/var/lib/aeon/ipfs-models"
CATALOG = os.path.join(MODELS_DIR, "catalog.json")
REGISTRY = os.path.join(MODELS_DIR, "registry.json")
MESH = os.path.join(MODELS_DIR, "mesh.json")
STARS = os.path.join(MODELS_DIR, "stars.json")  # CIDs this Orb starred (gossiped)
FLEET_TOML = "/etc/aeon/fleet.toml"
ANNOUNCE_FLAG = "/run/aeon/modelshare-announce"

# Same bytes / CID as aeon-ipfs.sh RENDEZVOUS_* — Amino findprovs of this CID
# is the WAN directory of live Magick Orbs.
RENDEZVOUS_CID = "bafkreidgutrbna4c363izsplxfzimihkz2fv3svoewwqcdqfmtczzfm46i"

ANNOUNCE_EVERY = 60       # seconds between periodic re-announcements
DISCOVER_EVERY = 45       # seconds between DHT rendezvous lookups
BEACON_EVERY = 300        # re-provide the rendezvous CID so new Orbs find us
PEER_TTL_MS = 15 * 60_000  # drop a peer not heard from in 15 min
MAX_MODELS = 500          # cap announcement size
MAX_SEEN = 128            # peer ids carried in one announcement
MAX_DIAL = 256            # persistent Orb links one node will hold

_lock = threading.Lock()
_inflight = set()
_inflight_lock = threading.Lock()
SELF_PID = ""  # our own peer id — cached in main(), used to skip self-announcements


def log(*a):
    print("aeon-modelshare:", *a, file=sys.stderr, flush=True)


def sh(*args, stdin=None, timeout=None):
    return subprocess.run(
        [SCRIPT, *args], input=stdin, capture_output=True, text=True, timeout=timeout
    )


def self_peer_id():
    try:
        r = sh("id", timeout=10)
        return r.stdout.strip()
    except Exception:
        return ""


def _is_loopback(ip):
    return ip.startswith("127.") or ip == "::1" or ip.startswith("::ffff:127.")


def _collect_host_ips():
    """IPv4s this box might be reachable at: hostname -I, Docker host, env."""
    ips = []
    try:
        out = subprocess.run(
            ["hostname", "-I"], capture_output=True, text=True, timeout=5
        ).stdout
        ips.extend(a for a in out.split() if ":" not in a and not _is_loopback(a))
    except Exception:
        pass
    raw = os.environ.get("AEON_IPFS_ANNOUNCE", "")
    for tok in raw.replace(",", " ").split():
        tok = tok.strip()
        if tok.startswith("/ip4/"):
            # /ip4/1.2.3.4/tcp/4001 → 1.2.3.4
            parts = tok.split("/")
            if len(parts) > 2 and parts[2] and ":" not in parts[2]:
                ips.append(parts[2])
        elif tok and not tok.startswith("/") and ":" not in tok and not _is_loopback(tok):
            ips.append(tok)
    try:
        ip = socket.getaddrinfo("host.docker.internal", None, socket.AF_INET)[0][4][0]
        if ip and not _is_loopback(ip):
            ips.append(ip)
    except Exception:
        pass
    seen, out = set(), []
    for ip in ips:
        if ip not in seen:
            seen.add(ip)
            out.append(ip)
    return out


def self_addrs():
    """Addresses peers can dial: LAN/tailnet IPv4s plus kubo-observed multiaddrs.

    Bare IPv4s stay in the list for older Orbs that only understand hostname -I
    style hints. Full multiaddrs (including /p2p-circuit) let WAN peers pin a
    relay path as persistent Peering.
    """
    addrs = list(_collect_host_ips())
    try:
        r = sh("addrs", timeout=10)
        for line in (r.stdout or "").splitlines():
            a = line.strip()
            if not a.startswith("/"):
                continue
            if "/ip4/127." in a or a.startswith("/ip6/::1") or "/ip4/0.0.0.0/" in a:
                continue
            addrs.append(a)
    except Exception:
        pass
    seen, out = set(), []
    for a in addrs:
        if a not in seen:
            seen.add(a)
            out.append(a)
    return out


def self_label():
    """Human label for this Orb: the fleet.toml `label` if the user set one, else
    a readable-but-distinct fallback (hostname + peer-id tail). The old version
    returned the value AS-IS, which for an empty `label =  # comment` line handed
    back the COMMENT text — that's what showed up as the peer name."""
    try:
        with open(FLEET_TOML) as f:
            for line in f:
                s = line.strip()
                if s.startswith("label"):
                    val = s.split("=", 1)[1].strip()
                    if val.startswith('"'):          # quoted value
                        end = val.find('"', 1)
                        val = val[1:end] if end > 0 else val[1:]
                    else:                             # bare token + optional # comment
                        val = val.split("#", 1)[0].strip()
                    if val:
                        return val
                    break
    except Exception:
        pass
    try:
        host = subprocess.run(["hostname"], capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:
        host = "orb"
    tail = SELF_PID[-4:] if SELF_PID else ""
    return f"{host}·{tail}" if tail else host


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def write_json_atomic(path, obj):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


def _private_ip(text):
    """RFC1918, loopback, link-local, CGNAT. Not a WAN dial target."""
    import re
    if not text:
        return False
    ips = re.findall(r"(\d+\.\d+\.\d+\.\d+)", text)
    if not ips and re.match(r"^\d+\.\d+\.\d+\.\d+$", text):
        ips = [text]
    for ip in ips:
        a, b = (int(x) for x in ip.split(".")[:2])
        if a in (10, 127) or (a == 192 and b == 168) or (a == 169 and b == 254):
            return True
        if a == 172 and 16 <= b <= 31:
            return True
        if a == 100 and 64 <= b <= 127:
            return True
    return False


def _wan_addr(addr, pid):
    """Keep public multiaddrs and relay circuits. Drop another home's LAN IP."""
    if not addr or addr == pid:
        return None
    if addr.startswith("/"):
        maddr = addr if "/p2p/" in addr else (addr.rstrip("/") + "/p2p/" + pid)
        if "/ip4/127." in maddr or maddr.startswith("/ip6/::1"):
            return None
        if "/p2p-circuit" in maddr:
            return maddr
        if _private_ip(maddr):
            return None
        return maddr
    if ":" in addr or addr.startswith("127.") or _private_ip(addr):
        return None
    return "/ip4/%s/tcp/4001/p2p/%s" % (addr, pid)


def seen_peer_ids():
    """Orbs we already know. Gossiping this is how a new node learns the rest
    from the first one it reaches — one DHT answer is not the whole swarm."""
    reg = read_json(REGISTRY, {"peers": {}})
    ids = []
    for pid in (reg.get("peers") or {}):
        if _looks_like_peer_id(pid):
            ids.append(pid)
        if len(ids) >= MAX_SEEN:
            break
    return ids


def build_announcement():
    return {
        "v": 1,
        "peer_id": self_peer_id(),
        "label": self_label(),
        "addrs": self_addrs(),
        "seen": seen_peer_ids(),
        "updated_ms": int(time.time() * 1000),
        "models": read_json(CATALOG, [])[:MAX_MODELS],
        "starred": read_json(STARS, [])[:MAX_MODELS],
    }


def publish():
    ann = build_announcement()
    if not ann["peer_id"]:
        return
    try:
        sh("pub", TOPIC, stdin=json.dumps(ann), timeout=15)
    except Exception as e:
        log("publish failed:", e)


def persist_connected(pid):
    """Pin every live path to this Orb as Peering so ConnMgr cannot prune it.

    Prefer the relay circuit when both a direct and a relayed connection are
    up: the circuit still works after a NAT binding expires."""
    try:
        r = sh("peers", timeout=10)
    except Exception:
        return
    lines = []
    for line in (r.stdout or "").splitlines():
        line = line.strip()
        if pid in line and line.startswith("/") and "/ip4/127." not in line:
            lines.append(line)
    lines.sort(key=lambda a: (0 if "/p2p-circuit" in a else 1))
    for line in lines[:4]:
        sh("peer", line, timeout=10)


def keep_connected_async(pid, addrs):
    """Don't block the pubsub reader on DHT dials (they can take tens of seconds)."""
    if not pid or pid == SELF_PID:
        return
    with _inflight_lock:
        if pid in _inflight:
            return
        _inflight.add(pid)

    def run():
        try:
            keep_connected(pid, addrs)
        finally:
            with _inflight_lock:
                _inflight.discard(pid)

    threading.Thread(target=run, daemon=True).start()


def keep_connected(pid, addrs):
    """Dial an Orb over the public swarm. No LAN IP and no open port required.

    `swarm connect /p2p/<id>` lets kubo use whatever it knows: a public address,
    a hole-punched path, or a /p2p-circuit through a relay. Relay circuits are
    then pinned as Peering so the link survives ConnMgr.
    """
    if not pid or pid == SELF_PID:
        return
    sh("connect", "/p2p/%s" % pid, timeout=25)
    persist_connected(pid)
    wan = []
    for a in addrs or []:
        maddr = _wan_addr(a, pid)
        if maddr and maddr not in wan:
            wan.append(maddr)
    wan.sort(key=lambda a: (0 if "/p2p-circuit" in a else 1))
    for maddr in wan[:4]:
        sh("peer", maddr, timeout=10)
        sh("connect", maddr, timeout=20)


def merge_peer(ann):
    pid = ann.get("peer_id")
    if not pid or not isinstance(ann.get("models"), list):
        return
    if pid == SELF_PID:
        return  # our own announcement (floodsub delivers it back) — don't index self
    keep_connected_async(pid, ann.get("addrs"))
    # One Orb's announcement names the others it has already met, so joining
    # any single node is enough to learn the rest of the live mesh.
    for other in ann.get("seen") or []:
        if isinstance(other, str) and _looks_like_peer_id(other):
            keep_connected_async(other, [])
    with _lock:
        reg = read_json(REGISTRY, {"peers": {}})
        peers = reg.setdefault("peers", {})
        peers[pid] = {
            "peer_id": pid,
            "label": ann.get("label", ""),
            "addrs": ann.get("addrs", []),
            "updated_ms": ann.get("updated_ms", int(time.time() * 1000)),
            "models": ann["models"],
            "starred": ann.get("starred", []) if isinstance(ann.get("starred"), list) else [],
        }
        # prune stale peers
        now = int(time.time() * 1000)
        for k in [k for k, v in peers.items() if now - v.get("updated_ms", 0) > PEER_TTL_MS]:
            del peers[k]
        try:
            write_json_atomic(REGISTRY, reg)
        except Exception as e:
            log("registry write failed:", e)


SUBFILE = "/run/aeon/modelshare-sub.ndjson"


def sub_loop():
    """Reconnecting subscriber. Each line from `aeon-ipfs sub` is one JSON
    announcement (kubo emits one pubsub message per line).

    IMPORTANT: kubo's `pubsub sub` BUFFERS its stdout when it's a pipe, so small,
    infrequent announcements never flush to a reader — a subscriber reading the
    pipe silently receives nothing. Writing to a real FILE flushes per message,
    so we point the subscriber at a file and TAIL it. The file lives on tmpfs
    (/run) and is truncated on every (re)connect to bound its size; we also
    recycle the subscription periodically to keep it small and freshly meshed."""
    os.makedirs(os.path.dirname(SUBFILE), exist_ok=True)
    while True:
        p = None
        try:
            open(SUBFILE, "w").close()  # truncate
            fout = open(SUBFILE, "wb")
            p = subprocess.Popen([SCRIPT, "sub", TOPIC], stdout=fout,
                                 stderr=subprocess.DEVNULL)
            fout.close()
            start = time.time()
            with open(SUBFILE, "r") as fin:
                while p.poll() is None:
                    line = fin.readline()
                    if line:
                        line = line.strip()
                        if line:
                            try:
                                merge_peer(json.loads(line))
                            except Exception:
                                pass  # malformed / foreign message
                    else:
                        if time.time() - start > 600:
                            break  # recycle: truncate the tmpfs file + re-mesh
                        time.sleep(0.3)
        except Exception as e:
            log("sub loop error:", e)
        finally:
            if p is not None:
                try:
                    p.terminate()
                    p.wait(timeout=3)
                except Exception:
                    pass
        time.sleep(3)  # daemon restarted / not ready yet — back off and retry


def pub_loop():
    last = 0.0
    while True:
        now = time.time()
        flag = os.path.exists(ANNOUNCE_FLAG)
        if flag:
            try:
                os.remove(ANNOUNCE_FLAG)
            except Exception:
                pass
        if flag or (now - last) >= ANNOUNCE_EVERY:
            publish()
            last = now
        time.sleep(2)


def _looks_like_peer_id(s):
    # CIDv0 Qm… or CIDv1 PeerIDs (12D3KooW…, bafz…, etc.)
    if not s or s == SELF_PID or s == RENDEZVOUS_CID:
        return False
    if s.startswith("Qm") and len(s) >= 46:
        return True
    if s.startswith("12D3Koo") or s.startswith("bafz") or s.startswith("k51"):
        return True
    return len(s) >= 32 and all(c.isalnum() for c in s)


def _dial_peers(pids):
    sem = threading.Semaphore(8)
    threads = []

    def one(pid):
        with sem:
            keep_connected(pid, [])

    n = 0
    for pid in pids:
        if n >= MAX_DIAL:
            break
        t = threading.Thread(target=one, args=(pid,), daemon=True)
        t.start()
        threads.append(t)
        n += 1
    for t in threads:
        t.join(timeout=50)
    return n


def discover_loop():
    """Find other Magick Orbs and stay connected to them.

    Floodsub only reaches currently-connected subscribers. Public IPFS peers
    are not on our topic, so two Orbs both 'on IPFS' still miss each other
    until we swarm-connect. findprovs(rendezvous) is the directory; peer ids
    already in the registry are redialed too, in case the DHT answer is partial.
    """
    time.sleep(20)  # let kubo finish boot + first provide
    while True:
        try:
            r = sh("findprovs", RENDEZVOUS_CID, timeout=90)
            lines = [ln.strip() for ln in (r.stdout or "").splitlines() if ln.strip()]
            providers = []
            for ln in lines:
                if _looks_like_peer_id(ln) and ln != SELF_PID and ln not in providers:
                    providers.append(ln)
            pids = []
            seen = set()
            for pid in providers + seen_peer_ids():
                if pid in seen or pid == SELF_PID:
                    continue
                seen.add(pid)
                pids.append(pid)
            n = _dial_peers(pids)
            try:
                write_json_atomic(MESH, {
                    "beacon": RENDEZVOUS_CID,
                    "providers": providers,
                    # This node plus every other provider the DHT just named.
                    "orbs_on_beacon": len(providers) + (1 if SELF_PID else 0),
                    "dialed": n,
                    "updated_ms": int(time.time() * 1000),
                })
            except Exception as e:
                log("mesh write failed:", e)
            log("mesh: %d on beacon, dialed %d" % (len(providers) + 1, n))
        except Exception as e:
            log("dht rendezvous failed:", e)
        time.sleep(DISCOVER_EVERY)


def beacon_loop():
    """Keep this node in the DHT directory of live Orbs."""
    time.sleep(10)
    while True:
        ok = False
        try:
            r = sh("beacon", timeout=40)
            cid = (r.stdout or "").strip().splitlines()[-1] if (r.stdout or "").strip() else ""
            if r.returncode == 0 and cid.startswith("ba"):
                log("rendezvous beacon", cid)
                ok = True
            else:
                err = ((r.stderr or "") or (r.stdout or "")).strip().replace("\n", " ")
                log("beacon pin failed", err[:180])
        except Exception as e:
            log("beacon failed:", e)
        # A restart often races the first pin. Try again shortly instead of
        # waiting out the full reprovide interval.
        time.sleep(BEACON_EVERY if ok else 20)


def wait_for_daemon():
    """Block until the local IPFS node answers (peer id resolves)."""
    while not self_peer_id():
        time.sleep(5)


def main():
    global SELF_PID
    os.makedirs(MODELS_DIR, exist_ok=True)
    # `up` restarts kubo once for the gateway page. Don't cache an empty id
    # from the gap between those two processes.
    while not SELF_PID:
        wait_for_daemon()
        SELF_PID = self_peer_id()
        if not SELF_PID:
            time.sleep(2)
    log("online; gossiping on", TOPIC, "as", SELF_PID)
    threading.Thread(target=sub_loop, daemon=True).start()
    threading.Thread(target=beacon_loop, daemon=True).start()
    threading.Thread(target=discover_loop, daemon=True).start()
    pub_loop()


if __name__ == "__main__":
    main()
