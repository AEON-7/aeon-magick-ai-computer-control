VERIFY_BUDGET = 64

SELF_PID = ""  # our own peer id — cached in main(), used to skip self-announcements

_CID_RE = re.compile(r"^[A-Za-z0-9]{10,128}$")
_IPV4_RE = re.compile(r"(\d+\.\d+\.\d+\.\d+)")


def log(*a):
    print("aeon-modelshare:", *a, file=sys.stderr, flush=True)


def now_ms():
    return int(time.time() * 1000)


def sh(*args, stdin=None, timeout=None):
    return subprocess.run(
        [SCRIPT, *args], input=stdin, capture_output=True, text=True, timeout=timeout
    )


def self_peer_id():
    try:
        r = sh("id", timeout=10)
        return r.stdout.strip()
    except Exception:
        return ""


def _is_loopback(ip):
    return ip.startswith("127.") or ip == "::1" or ip.startswith("::ffff:127.")


def _collect_host_ips():
    """IPv4s this box might be reachable at: hostname -I, Docker host, env."""
    ips = []
    try:
        out = subprocess.run(
            ["hostname", "-I"], capture_output=True, text=True, timeout=5
        ).stdout
        ips.extend(a for a in out.split() if ":" not in a and not _is_loopback(a))
    except Exception:
        pass
    raw = os.environ.get("AEON_IPFS_ANNOUNCE", "")
    for tok in raw.replace(",", " ").split():
        tok = tok.strip()
        if tok.startswith("/ip4/"):
            # /ip4/1.2.3.4/tcp/4001 → 1.2.3.4
            parts = tok.split("/")
            if len(parts) > 2 and parts[2] and ":" not in parts[2]:
                ips.append(parts[2])
        elif tok and not tok.startswith("/") and ":" not in tok and not _is_loopback(tok):
            ips.append(tok)
    try:
        ip = socket.getaddrinfo("host.docker.internal", None, socket.AF_INET)[0][4][0]
        if ip and not _is_loopback(ip):
            ips.append(ip)
    except Exception:
        pass
    return _dedupe(ips)


def _dedupe(items):
    seen, out = set(), []
    for it in items:
        if it not in seen:
            seen.add(it)
            out.append(it)
    return out


def self_addrs():
    """Addresses peers can dial: LAN/tailnet IPv4s plus kubo-observed multiaddrs.

    Bare IPv4s stay in the list for older Orbs that only understand hostname -I
    style hints. Full multiaddrs (including /p2p-circuit) let WAN peers pin a
    relay path as persistent Peering.
    """
    addrs = list(_collect_host_ips())
    try:
        r = sh("addrs", timeout=10)
        for line in (r.stdout or "").splitlines():
            a = line.strip()
            if not a.startswith("/"):
                continue
            if "/ip4/127." in a or a.startswith("/ip6/::1") or "/ip4/0.0.0.0/" in a:
                continue
            addrs.append(a)
    except Exception:
        pass
    return _dedupe(addrs)


def self_label():
    """Human label for this Orb: the fleet.toml `label` if the user set one, else
    a readable-but-distinct fallback (hostname + peer-id tail). The old version
    returned the value AS-IS, which for an empty `label =  # comment` line handed
    back the COMMENT text — that's what showed up as the peer name."""
    try:
        with open(FLEET_TOML) as f:
            for line in f:
                s = line.strip()
                if s.startswith("label"):
                    val = s.split("=", 1)[1].strip()
                    if val.startswith('"'):          # quoted value
                        end = val.find('"', 1)
                        val = val[1:end] if end > 0 else val[1:]
                    else:                             # bare token + optional # comment
                        val = val.split("#", 1)[0].strip()
                    if val:
                        return val
                    break
    except Exception:
        pass
    try:
        host = subprocess.run(["hostname"], capture_output=True, text=True, timeout=3).stdout.strip()
    except Exception:
        host = "orb"
    tail = SELF_PID[-4:] if SELF_PID else ""
    return f"{host}·{tail}" if tail else host


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return default


def write_json_atomic(path, obj):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f)
    os.replace(tmp, path)


def _private_ip(text):
    """RFC1918, loopback, link-local, CGNAT. Not a WAN dial target."""
    if not text:
        return False
    for ip in _IPV4_RE.findall(text):
        a, b = (int(x) for x in ip.split(".")[:2])
        if a in (10, 127) or (a == 192 and b == 168) or (a == 169 and b == 254):
            return True
        if a == 172 and 16 <= b <= 31:
            return True
        if a == 100 and 64 <= b <= 127:
            return True
    return False


def _wan_addr(addr, pid):
    """Keep public multiaddrs and relay circuits. Drop another home's LAN IP."""
    if not addr or addr == pid:
        return None
    if addr.startswith("/"):
        maddr = addr if "/p2p/" in addr else (addr.rstrip("/") + "/p2p/" + pid)
        if "/ip4/127." in maddr or maddr.startswith("/ip6/::1"):
            return None
        if "/p2p-circuit" in maddr:
            return maddr
        if _private_ip(maddr):
            return None
        return maddr
    if ":" in addr or addr.startswith("127.") or _private_ip(addr):
        return None
    return "/ip4/%s/tcp/4001/p2p/%s" % (addr, pid)


def _peer_id_shape(s):
    """Shape check only: CIDv0 Qm… or CIDv1 PeerIDs (12D3KooW…, bafz…, k51…)."""
    if not isinstance(s, str) or not s or len(s) > 128 or not s.isalnum():
        return False
    if s.startswith("Qm") and len(s) >= 46:
        return True
    if s.startswith("12D3Koo") or s.startswith("bafz") or s.startswith("k51"):
        return True
    return len(s) >= 32


def _looks_like_peer_id(s):
    """A peer id that is some OTHER Orb's (not ours, not the beacon CID)."""
    return _peer_id_shape(s) and s != SELF_PID and s != RENDEZVOUS_CID


def _clean_text(s, limit):
    """Printable text, bounded. Peers choose these strings; the console shows them."""
    if not isinstance(s, str):
        return ""
    return "".join(ch for ch in s if ch >= " " and ch != "\x7f")[:limit]


# ── What we accept from the network ─────────────────────────────────────────

def decode_envelope(line):
    """One line of `aeon-ipfs sub-json` → (sender_peer_id, payload_text).

    The sender is the peer libp2p verified the message's signature against —
    the only trustworthy statement of who said it. (None, None) if the line is
    not an envelope.
    """
    try:
        env = json.loads(line)
    except ValueError:
        return None, None
    if not isinstance(env, dict):
        return None, None
    sender, data = env.get("from"), env.get("data")
    if not isinstance(sender, str) or not isinstance(data, str):
        return None, None
    return sender, _decode_payload(data)


def _decode_payload(data):
    """kubo multibase-encodes pubsub payloads ('u' + unpadded base64url). Older
    builds used plain base64; accept either, and raw JSON as a last resort."""
    attempts = []
    if data.startswith("u"):
        body = data[1:]
        attempts.append(lambda: base64.urlsafe_b64decode(body + "=" * (-len(body) % 4)))
    attempts.append(lambda: base64.b64decode(data + "=" * (-len(data) % 4), validate=True))
    for attempt in attempts:
        try:
            text = attempt().decode("utf-8")
        except Exception:
            continue
        if text.lstrip().startswith("{"):
            return text
    return data if data.lstrip().startswith("{") else None


# ── Ed25519 verification (RFC 8032), standard library only ──────────────────
#
# Witness statements are signed claims that travel with a model entry. A claim
# whose signature does not hold must not be passed on, so the daemon checks
# each one itself instead of leaving it all to the supervisor. Verification
# only: there is no secret here and nothing to keep constant-time.

_P = 2 ** 255 - 19
_L = 2 ** 252 + 27742317777372353535851937790883648493
_D = -121665 * pow(121666, _P - 2, _P) % _P
_SQRT_M1 = pow(2, (_P - 1) // 4, _P)


def _ed_recover_x(y, sign):
    if y >= _P:
        return None
    x2 = (y * y - 1) * pow(_D * y * y + 1, _P - 2, _P) % _P
    if x2 == 0:
        return None if sign else 0
    x = pow(x2, (_P + 3) // 8, _P)
    if (x * x - x2) % _P != 0:
        x = x * _SQRT_M1 % _P
    if (x * x - x2) % _P != 0:
        return None
    if (x & 1) != sign:
        x = _P - x
    return x


_GY = 4 * pow(5, _P - 2, _P) % _P
_GX = _ed_recover_x(_GY, 0)
_G = (_GX, _GY, 1, _GX * _GY % _P)


def _ed_add(p, q):
    a = (p[1] - p[0]) * (q[1] - q[0]) % _P
    b = (p[1] + p[0]) * (q[1] + q[0]) % _P
    c = 2 * p[3] * q[3] * _D % _P
    d = 2 * p[2] * q[2] % _P
    e, f, g, h = b - a, d - c, d + c, b + a
    return (e * f % _P, g * h % _P, f * g % _P, e * h % _P)


def _ed_mul(s, p):
    q = (0, 1, 1, 0)
    while s > 0:
        if s & 1:
            q = _ed_add(q, p)
        p = _ed_add(p, p)
        s >>= 1
    return q


def _ed_decompress(b):
    if len(b) != 32:
        return None
    y = int.from_bytes(b, "little")
    sign = y >> 255
    y &= (1 << 255) - 1
    x = _ed_recover_x(y, sign)
    if x is None:
        return None
    return (x, y, 1, x * y % _P)


def ed25519_verify(pub, msg, sig):
    """True iff `sig` (64 bytes) is `pub`'s (32 bytes) signature over `msg`."""
    if len(pub) != 32 or len(sig) != 64:
        return False
    a = _ed_decompress(pub)
    r = _ed_decompress(sig[:32])
    if a is None or r is None:
        return False
    s = int.from_bytes(sig[32:], "little")
    if s >= _L:
        return False
    h = int.from_bytes(hashlib.sha512(sig[:32] + pub + msg).digest(), "little") % _L
    left = _ed_mul(s, _G)
    right = _ed_add(r, _ed_mul(h, a))
    return (left[0] * right[2] - right[0] * left[2]) % _P == 0 \
        and (left[1] * right[2] - right[1] * left[2]) % _P == 0


_HEX64_RE = re.compile(r"^[0-9a-f]{64}$")
_PROVIDER_RE = re.compile(r"^[a-z0-9-]{1,32}$")
_sig_cache = {}  # (key, sig, sha256 of the signed text) → bool


class VerifyBudget:
    """How many NEW signature checks one announcement may still cost."""

    def __init__(self, left=VERIFY_BUDGET):
        self.left = left


def signature_ok(key_hex, text, sig_b64, budget):
    """True / False for a checked signature, None when the budget ran out
    before this one could be checked (try again on a later announcement)."""
    if not (isinstance(key_hex, str) and _HEX64_RE.match(key_hex.lower())):
        return False
    if not isinstance(sig_b64, str) or not 0 < len(sig_b64) <= 128:
        return False
    cache_key = (key_hex.lower(), sig_b64, hashlib.sha256(text).hexdigest())
    if cache_key in _sig_cache:
        return _sig_cache[cache_key]
    if budget.left <= 0:
        return None
    budget.left -= 1
    try:
        sig = base64.b64decode(sig_b64, validate=True)
        ok = ed25519_verify(bytes.fromhex(key_hex), text, sig)
    except Exception:
        ok = False
    if len(_sig_cache) > 20000:
        _sig_cache.clear()
    _sig_cache[cache_key] = ok
    return ok


def _has_control(s):
    """Any control character at all (Unicode category Cc), as the supervisor
    judges it — a newline inside a field would forge a line of signed text."""
    return any(unicodedata.category(ch) == "Cc" for ch in s)


def _one_line(s, limit):
    return isinstance(s, str) and 0 < len(s) <= limit and not _has_control(s)


def _safe_rel_path(p):
    if not isinstance(p, str) or not p or len(p) > 1024 or p.startswith("/") or _has_control(p) or "\\" in p:
        return False
    return all(seg not in ("", ".", "..") for seg in p.split("/"))


def clean_record(rec):
    """An upstream record rebuilt field by field, files in path order — or
    None when it is not one (docs/MODEL_SHARE_PROTOCOL.md §10)."""
    if not isinstance(rec, dict):
        return None
    provider, repo, revision, files = rec.get("provider"), rec.get("repo"), rec.get("revision"), rec.get("files")
    if not (isinstance(provider, str) and _PROVIDER_RE.match(provider)):
        return None
    if not _one_line(repo, 200) or not _one_line(revision, 200):
        return None
    if not isinstance(files, list) or not 0 < len(files) <= MAX_RECORD_FILES:
        return None
    clean, seen = [], set()
    for f in files:
        if not isinstance(f, dict):
            return None
        path, size, sha, source = f.get("path"), f.get("size"), f.get("sha256"), f.get("hash_from")
        if not _safe_rel_path(path) or path in seen:
            return None
        if not isinstance(size, int) or isinstance(size, bool) or not 0 <= size < 2 ** 63:
            return None
        if not isinstance(sha, str) or not _HEX64_RE.match(sha.lower()):
            return None
        if source not in ("provider", "computed"):
            return None
        seen.add(path)
        clean.append({"path": path, "size": size, "sha256": sha.lower(), "hash_from": source})
    clean.sort(key=lambda f: f["path"].encode("utf-8"))
    return {"provider": provider, "repo": repo, "revision": revision, "files": clean}


def witness_text(rec, observed_ms):
    """The exact bytes an `aeon-witness/1` statement signs: only the files
    whose SHA-256 the provider itself published, in path order (UTF-8 bytes)."""
    lines = "".join("%s %d %s\n" % (f["sha256"], f["size"], f["path"])
                    for f in rec["files"] if f["hash_from"] == "provider")
    head = "aeon-witness/1\n%s\n%s\n%s\n%d\n" % (rec["provider"], rec["repo"], rec["revision"], observed_ms)
    return (head + lines).encode("utf-8")


def _clean_delegation(d, orb_key, budget):
    """A delegation naming `orb_key`, if the user key really signed it."""
    if not isinstance(d, dict) or d.get("orb_key") != orb_key:
        return None
    user_key, sig, issued = d.get("user_key"), d.get("sig"), d.get("issued_ms")
    if not isinstance(issued, int) or isinstance(issued, bool):
        return None
    text = ("aeon-delegate/1\n%s\n%s\n%d" % (user_key, orb_key, issued)).encode("utf-8")
    if not signature_ok(user_key, text, sig, budget):
        return None
    return {"user_key": user_key, "user_name": _clean_text(d.get("user_name"), 40),
            "orb_key": orb_key, "issued_ms": issued, "sig": sig}


def clean_witnesses(rec, witnesses, budget):
    """The witness statements whose signature holds for `rec`, rebuilt field
    by field. One that fails, or cannot be checked within the budget, is
    dropped. A delegation that does not hold is dropped and the statement is
    kept, credited to the key that signed it."""
    out = []
    if not isinstance(witnesses, list) or not any(f["hash_from"] == "provider" for f in rec["files"]):
        return out
    for w in witnesses[:MAX_WITNESSES * 4]:
        if len(out) >= MAX_WITNESSES:
            break
        if not isinstance(w, dict):
            continue
        key, sig, observed = w.get("key"), w.get("sig"), w.get("observed_ms")
        if not isinstance(observed, int) or isinstance(observed, bool) or observed <= 0:
            continue
        if not signature_ok(key, witness_text(rec, observed), sig, budget):
            continue
        clean = {"key": key, "observed_ms": observed, "sig": sig}
        delegation = _clean_delegation(w.get("delegation"), key, budget)
        if delegation:
            clean["delegation"] = delegation
        out.append(clean)
    return out


def clean_provenance(m, budget):
    """A model entry with its upstream record and witnesses held to the rules.

    Everything else in the entry passes through as it came. A record that is
    not well-formed is removed together with its witnesses; a witness whose
    signature does not hold for the record is removed alone.
    """
    if "upstream_record" not in m and "witnesses" not in m:
        return m
    m = dict(m)
    rec = clean_record(m.pop("upstream_record", None))
    witnesses = m.pop("witnesses", None)
    if rec is None:
        return m
    m["upstream_record"] = rec
    kept = clean_witnesses(rec, witnesses, budget)
    if kept:
        m["witnesses"] = kept
    return m


def sanitize_announcement(ann):
    """Reduce a peer's announcement to the fields and sizes we accept, or None.

    Model entries pass through verbatim (the supervisor parses and verifies
    them) but only if they are well-formed and bounded; everything else is
    rebuilt field by field, so an unexpected or oversized key never reaches
    the registry. The exception inside an entry is its upstream record and
    witness statements: those are rebuilt, and each witness signature is
    checked here, so a statement nobody signed is never stored or shown.
    """
    if not isinstance(ann, dict):
        return None
    pid, models = ann.get("peer_id"), ann.get("models")
    if not _peer_id_shape(pid) or not isinstance(models, list):
        return None
    clean = []
    budget = VerifyBudget()
    for m in models[:MAX_MODELS]:
        if not isinstance(m, dict):
            continue
        cid, name = m.get("cid"), m.get("name")
        if not isinstance(cid, str) or not _CID_RE.match(cid):
            continue
        if not isinstance(name, str) or not name.strip():
            continue
        try:
            if len(json.dumps(m)) > MAX_ENTRY_BYTES:
                continue
        except (TypeError, ValueError):
            continue
        clean.append(clean_provenance(m, budget))
    addrs = ann.get("addrs") if isinstance(ann.get("addrs"), list) else []
    seen = ann.get("seen") if isinstance(ann.get("seen"), list) else []
    starred = ann.get("starred") if isinstance(ann.get("starred"), list) else []
    out = {
        "peer_id": pid,
        "label": _clean_text(ann.get("label"), 64),
        "addrs": [a for a in addrs if isinstance(a, str) and 0 < len(a) <= 256][:16],
        "seen": [s for s in seen if _peer_id_shape(s)][:MAX_SEEN],
        "models": clean,
        "starred": [c for c in starred if isinstance(c, str) and _CID_RE.match(c)][:MAX_MODELS],
        "sent_ms": ann.get("updated_ms") if isinstance(ann.get("updated_ms"), int) else 0,
    }
    # The origin binding: opaque here, verified by the supervisor.
    key, sig = ann.get("orb_key"), ann.get("orb_sig")
    if isinstance(key, str) and isinstance(sig, str) and len(key) == 64 and len(sig) <= 128:
        out["orb_key"], out["orb_sig"] = key, sig
        d = ann.get("delegation")
        if isinstance(d, dict):
            clean = {
                "user_key": d.get("user_key"), "orb_key": d.get("orb_key"), "sig": d.get("sig"),
                "user_name": _clean_text(d.get("user_name"), 40),
                "issued_ms": d.get("issued_ms") if isinstance(d.get("issued_ms"), int) else 0,
            }
            if all(isinstance(clean[k], str) and 0 < len(clean[k]) <= 128 for k in ("user_key", "orb_key", "sig")):
                out["delegation"] = clean
    return out


def accept_message(sender, payload):
    """A sanitized announcement iff `payload` is one AND it speaks for `sender`.

    Returns (announcement, None) or (None, reason-it-was-dropped).
    """
    if not payload:
        return None, "empty"
    try:
        raw = json.loads(payload)
    except ValueError:
        return None, "not json"
    ann = sanitize_announcement(raw)
    if ann is None:
        return None, "not an announcement"
    if ann["peer_id"] != sender:
        # The message is genuine — it just is not from who it says it is.
        return None, "sender %s claims to be %s" % (sender[-8:], ann["peer_id"][-8:])
    return ann, None


class LineBuffer:
    """Reassembles lines from a file being appended to.

    `readline()` on a growing file returns a PARTIAL line when it catches the
    writer mid-write, and the remainder later as if it were its own line — so
    a large announcement was parsed as two pieces of garbage and lost. Only
    newline-terminated lines are handed out here.
    """

    def __init__(self, limit=4 * 1024 * 1024):
        self._buf = ""
        self._limit = limit

    def feed(self, chunk):
        self._buf += chunk
        if "\n" not in self._buf:
            if len(self._buf) > self._limit:  # a line that never ends: discard
                self._buf = ""
            return []
        *lines, self._buf = self._buf.split("\n")
        return [ln.strip() for ln in lines if ln.strip()]


# ── The registry ────────────────────────────────────────────────────────────

class Registry:
    """Every Orb heard on the topic, keyed by peer id.

    Held in memory and written out sparingly. It used to be re-read and
    re-written in full on every announcement — on an SD card, with the cost
    growing as (orbs x catalog size) per message.
    """

    def __init__(self, path):
        self.path = path
        self._lock = threading.Lock()
        peers = read_json(path, {"peers": {}}).get("peers")
        self.peers = peers if isinstance(peers, dict) else {}
        self._content_dirty = False
        self._dirty = False
        self._flushed_at = 0.0

    @staticmethod
    def _content(rec):
        return {k: v for k, v in rec.items() if k not in ("updated_ms", "sent_ms")}

    def merge(self, ann, at_ms):
        """Record an accepted announcement as heard at local time `at_ms`.

        Freshness is OUR clock, not the sender's: a peer could otherwise claim
        a time far in the future and never expire, and an Orb whose clock is
        not yet set (a Pi has no RTC) was pruned by everyone the moment it
        announced.
        """
        rec = {
            "peer_id": ann["peer_id"],
            "label": ann["label"],
            "addrs": ann["addrs"],
            "updated_ms": at_ms,
            "sent_ms": ann.get("sent_ms", 0),
            "models": ann["models"],
            "starred": ann["starred"],
        }
        if "orb_key" in ann:
            rec["orb_key"], rec["orb_sig"] = ann["orb_key"], ann["orb_sig"]
            if "delegation" in ann:
                rec["delegation"] = ann["delegation"]
        with self._lock:
            old = self.peers.get(rec["peer_id"])
            if old is None or self._content(old) != self._content(rec):
                self._content_dirty = True
            self.peers[rec["peer_id"]] = rec
            self._dirty = True
            self._prune(at_ms)

    def _prune(self, at_ms):
        stale = [k for k, v in self.peers.items()
                 if at_ms - (v.get("updated_ms") or 0) > PEER_TTL_MS]
        for k in stale:
            del self.peers[k]
        if len(self.peers) > MAX_PEERS:
            oldest = sorted(self.peers, key=lambda k: self.peers[k].get("updated_ms") or 0)
            for k in oldest[: len(self.peers) - MAX_PEERS]:
                del self.peers[k]
        if stale:
            self._content_dirty = True

    def prune(self, at_ms):
        with self._lock:
            self._prune(at_ms)

    def peer_ids(self):
        with self._lock:
            return list(self.peers)

    def flush(self, now=None, force=False):
        """Write to disk if due. Returns True when a write happened."""
        now = time.time() if now is None else now
        with self._lock:
            age = now - self._flushed_at
            due = force or (self._content_dirty and age >= FLUSH_CHANGED_S) \
                or (self._dirty and age >= FLUSH_IDLE_S)
            if not due or not (self._dirty or self._content_dirty or force):
                return False
            snapshot = {"peers": dict(self.peers)}
            self._dirty = self._content_dirty = False
            self._flushed_at = now
        try:
            write_json_atomic(self.path, snapshot)
        except Exception as e:
            log("registry write failed:", e)
            return False
        return True


# ── Staying connected, cheaply ──────────────────────────────────────────────

class Dialer:
    """Keeps this node connected to other Orbs with a bounded amount of work.

    Before: every announcement spawned a thread per peer it mentioned (up to
    128), each running several kubo CLI processes, and discovery re-dialed
    every known peer every 45 s whether or not it was already connected — work
    that grew with the square of the mesh and would have swamped a Pi long
    before the network got big. Now: one cached `swarm peers` listing answers
    "already connected?", only the unconnected are dialed, a fixed pool does
    the dialing, and a peer that cannot be reached is retried on a doubling
    back-off instead of every pass.
    """

    def __init__(self, workers=DIAL_WORKERS):
        self._q = queue.Queue(maxsize=512)
        self._lock = threading.Lock()
        self._pending = set()
        self._fail = {}        # pid → (consecutive failures, retry-not-before)
        self._peered = set()   # pids whose link we have pinned as Peering
        self._conn = {}        # pid → [multiaddr lines]
        self._conn_at = 0.0
        self._workers = workers
        self._started = False

    def start(self):
        if self._started:
            return
        self._started = True
        for _ in range(self._workers):
            threading.Thread(target=self._work, daemon=True).start()

    def connected(self, force=False):
        """pid → live multiaddrs, from at most one `swarm peers` per TTL."""
        with self._lock:
            fresh = time.time() - self._conn_at < CONNECTED_TTL_S
            if fresh and not force:
                return self._conn
        conn = {}
        try:
            r = sh("peers", timeout=10)
            for line in (r.stdout or "").splitlines():
                line = line.strip()
                if line.startswith("/") and "/p2p/" in line:
                    conn.setdefault(line.rsplit("/p2p/", 1)[-1], []).append(line)
        except Exception:
            return self._conn
        with self._lock:
            self._conn, self._conn_at = conn, time.time()
        return conn

    def want(self, pid, addrs=()):
        """Ask for a link to `pid`. Returns True if a dial was queued."""
        if not _looks_like_peer_id(pid):
            return False
        with self._lock:
            if pid in self._pending:
                return False
            _, not_before = self._fail.get(pid, (0, 0.0))
            if time.time() < not_before:
                return False
            if pid in self._peered and pid in self._conn:
                return False
            self._pending.add(pid)
        try:
            self._q.put_nowait((pid, list(addrs or ())))
        except queue.Full:
            with self._lock:
                self._pending.discard(pid)
            return False
        return True

    def _work(self):
        while True:
            pid, addrs = self._q.get()
            try:
                ok = self._dial(pid, addrs)
            except Exception as e:
                ok = False
                log("dial error:", e)
            with self._lock:
                self._pending.discard(pid)
                if ok:
                    self._fail.pop(pid, None)
                else:
                    n = self._fail.get(pid, (0, 0.0))[0] + 1
                    self._fail[pid] = (n, time.time() + min(1800, 60 * 2 ** (n - 1)))
                    if len(self._fail) > 4096:  # bounded: forget the oldest waits
                        for k in sorted(self._fail, key=lambda k: self._fail[k][1])[:1024]:
                            del self._fail[k]

    def _dial(self, pid, addrs):
        """Dial an Orb over the public swarm. No LAN IP and no open port required.

        `swarm connect /p2p/<id>` lets kubo use whatever it knows: a public
        address, a hole-punched path, or a /p2p-circuit through a relay. Live
        paths are then pinned as Peering so ConnMgr cannot prune them.
        """
        if pid not in self.connected():
            sh("connect", "/p2p/%s" % pid, timeout=25)
        wan = []
        for a in addrs:
            maddr = _wan_addr(a, pid)
            if maddr and maddr not in wan:
                wan.append(maddr)
        # Prefer the relay circuit: it still works after a NAT binding expires.
        wan.sort(key=lambda a: (0 if "/p2p-circuit" in a else 1))
        live = self.connected(force=True).get(pid, [])
        if not live:
            for maddr in wan[:4]:
                sh("connect", maddr, timeout=20)
            live = self.connected(force=True).get(pid, [])
        if not live:
            return False
        paths = [p for p in live if "/ip4/127." not in p]
        paths.sort(key=lambda a: (0 if "/p2p-circuit" in a else 1))
        for path in (paths + wan)[:4]:
            sh("peer", path, timeout=10)
        with self._lock:
            self._peered.add(pid)
        return True


REG = None       # Registry, created in main()
DIALER = Dialer()
_dropped = {}    # reason → last time logged (rate-limits the spoof log)


def handle_line(line, at_ms=None):
    """One line from the subscriber → merged into the registry, or dropped."""
    sender, payload = decode_envelope(line)
    if sender is None:
        return False
    if sender == SELF_PID:
        return False  # floodsub delivers our own announcement back
    ann, why = accept_message(sender, payload)
    if ann is None:
        if why and why.startswith("sender") and time.time() - _dropped.get(why, 0) > 300:
            _dropped[why] = time.time()
            if len(_dropped) > 256:
                _dropped.clear()
            log("dropped announcement:", why)
        return False
    REG.merge(ann, now_ms() if at_ms is None else at_ms)
    DIALER.want(ann["peer_id"], ann["addrs"])
    # One Orb's announcement names others it has met, so joining any single
    # node is enough to learn the rest of the live mesh — a few at a time.
    asked = 0
    for other in ann["seen"]:
        if asked >= MAX_SEEN_DIAL:
            break
        if DIALER.want(other):
            asked += 1
    return True


def seen_peer_ids():
    """Orbs we already know. Gossiping this is how a new node learns the rest
    from the first one it reaches — one DHT answer is not the whole swarm."""
    ids = [pid for pid in (REG.peer_ids() if REG else []) if _looks_like_peer_id(pid)]
    return ids[:MAX_SEEN]


def build_announcement(peer_id=None):
    ann = {
        "v": 1,
        "peer_id": peer_id if peer_id is not None else self_peer_id(),
        "label": self_label(),
        "addrs": self_addrs(),
        "seen": seen_peer_ids(),
        "updated_ms": now_ms(),
        "models": read_json(CATALOG, [])[:MAX_MODELS],
        "starred": read_json(STARS, [])[:MAX_MODELS],
    }
    binding = read_json(BINDING, {})
    if isinstance(binding, dict) and binding.get("peer_id") == ann["peer_id"] and binding.get("orb_key"):
        ann["orb_key"] = binding["orb_key"]
        ann["orb_sig"] = binding.get("orb_sig", "")
        if isinstance(binding.get("delegation"), dict):
            ann["delegation"] = binding["delegation"]
    return fit_announcement(ann)


def fit_announcement(ann):
    """Trim an announcement to what pubsub will actually carry.

    Over the limit the publish fails silently and this Orb disappears from
    every index. Dropping the oldest tail keeps the Orb visible with most of
    its catalog instead.
    """
    if len(json.dumps(ann)) <= MAX_ANNOUNCE_BYTES:
        return ann
    ann = dict(ann, seen=[])
    models = list(ann["models"])
    while models and len(json.dumps(dict(ann, models=models))) > MAX_ANNOUNCE_BYTES:
        models = models[: max(0, len(models) - max(1, len(models) // 8))]
    if len(models) < len(ann["models"]):
        log("announcement too large: sending %d of %d models" % (len(models), len(ann["models"])))
    return dict(ann, models=models)


def publish():
    ann = build_announcement()
    if not ann["peer_id"]:
        return
    try:
        r = sh("pub", TOPIC, stdin=json.dumps(ann), timeout=15)
        if r.returncode != 0:
            log("publish failed (exit %d)" % r.returncode)
    except Exception as e:
        log("publish failed:", e)


def sub_loop():
    """Reconnecting subscriber. Each line from `aeon-ipfs sub-json` is one
    envelope (kubo emits one pubsub message per line).

    IMPORTANT: kubo's `pubsub sub` BUFFERS its stdout when it's a pipe, so small,
    infrequent announcements never flush to a reader — a subscriber reading the
    pipe silently receives nothing. Writing to a real FILE flushes per message,
    so we point the subscriber at a file and TAIL it. The file lives on tmpfs
    (/run) and is truncated on every (re)connect to bound its size; we also
    recycle the subscription periodically to keep it small and freshly meshed."""
    os.makedirs(os.path.dirname(SUBFILE), exist_ok=True)
    while True:
        p = None
        try:
            open(SUBFILE, "w").close()  # truncate
            fout = open(SUBFILE, "wb")
            p = subprocess.Popen([SCRIPT, "sub-json", TOPIC], stdout=fout,
                                 stderr=subprocess.DEVNULL)
            fout.close()
            start = time.time()
            lines = LineBuffer()
            with open(SUBFILE, "r") as fin:
                while p.poll() is None:
                    chunk = fin.read(256 * 1024)
                    if chunk:
                        for line in lines.feed(chunk):
                            try:
                                handle_line(line)
                            except Exception as e:
                                log("bad message:", e)
                    else:
                        if time.time() - start > 600:
                            break  # recycle: truncate the tmpfs file + re-mesh
                        time.sleep(0.3)
        except Exception as e:
            log("sub loop error:", e)
        finally:
            if p is not None:
                try:
                    p.terminate()
                    p.wait(timeout=3)
                except Exception:
                    pass
        time.sleep(3)  # daemon restarted / not ready yet — back off and retry


def pub_loop():
    last = 0.0
    while True:
        now = time.time()
        flag = os.path.exists(ANNOUNCE_FLAG)
        if flag:
            try:
                os.remove(ANNOUNCE_FLAG)
            except Exception:
                pass
        if flag or (now - last) >= ANNOUNCE_EVERY:
            publish()
            last = now
        REG.prune(now_ms())
        REG.flush()
        time.sleep(2)


def discover_loop():
    """Find other Magick Orbs and stay connected to them.

    Floodsub only reaches currently-connected subscribers. Public IPFS peers
    are not on our topic, so two Orbs both 'on IPFS' still miss each other
    until we swarm-connect. findprovs(rendezvous) is the directory; peer ids
    already in the registry are considered too, in case the DHT answer is
    partial. Only the ones not already connected cost a dial.
    """
    time.sleep(20)  # let kubo finish boot + first provide
    while True:
        try:
            r = sh("findprovs", RENDEZVOUS_CID, timeout=90)
            providers = _dedupe(
                ln.strip() for ln in (r.stdout or "").splitlines() if _looks_like_peer_id(ln.strip())
            )
            DIALER.connected(force=True)
            queued = sum(1 for pid in _dedupe(providers + seen_peer_ids())[:MAX_DIAL] if DIALER.want(pid))
            connected = DIALER.connected()
            try:
                write_json_atomic(MESH, {
                    "beacon": RENDEZVOUS_CID,
                    "providers": providers,
                    # This node plus every other provider the DHT just named.
                    "orbs_on_beacon": len(providers) + (1 if SELF_PID else 0),
                    "connected": sum(1 for pid in providers if pid in connected),
                    "dialed": queued,
                    "updated_ms": now_ms(),
                })
            except Exception as e:
                log("mesh write failed:", e)
            log("mesh: %d on beacon, %d connected, %d dialing" % (
                len(providers) + 1, sum(1 for pid in providers if pid in connected), queued))
        except Exception as e:
            log("dht rendezvous failed:", e)
        time.sleep(DISCOVER_EVERY)


def beacon_loop():
    """Keep this node in the DHT directory of live Orbs."""
    time.sleep(10)
    while True:
        ok = False
        try:
            r = sh("beacon", timeout=40)
            cid = (r.stdout or "").strip().splitlines()[-1] if (r.stdout or "").strip() else ""
            if r.returncode == 0 and cid.startswith("ba"):
                log("rendezvous beacon", cid)
                ok = True
            else:
                err = ((r.stderr or "") or (r.stdout or "")).strip().replace("\n", " ")
                log("beacon pin failed", err[:180])
        except Exception as e:
            log("beacon failed:", e)
        # A restart often races the first pin. Try again shortly instead of
        # waiting out the full reprovide interval.
        time.sleep(BEACON_EVERY if ok else 20)


def wait_for_daemon():
    """Block until the local IPFS node answers (peer id resolves)."""
    while not self_peer_id():
        time.sleep(5)


def main():
    global SELF_PID, REG
    os.makedirs(MODELS_DIR, exist_ok=True)
    REG = Registry(REGISTRY)
    # `up` restarts kubo once for the gateway page. Don't cache an empty id
    # from the gap between those two processes.
    while not SELF_PID:
        wait_for_daemon()
        SELF_PID = self_peer_id()
        if not SELF_PID:
            time.sleep(2)
    log("online; gossiping on", TOPIC, "as", SELF_PID)
    DIALER.start()
    threading.Thread(target=sub_loop, daemon=True).start()
    threading.Thread(target=beacon_loop, daemon=True).start()
    threading.Thread(target=discover_loop, daemon=True).start()
    pub_loop()


if __name__ == "__main__":
    main()
