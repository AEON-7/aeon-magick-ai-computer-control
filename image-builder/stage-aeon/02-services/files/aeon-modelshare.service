[Unit]
Description=Aeon Magick — Model Share gossip (fleet-free IPFS model index)
After=aeon-ipfs-boot.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aeon-modelshare
Restart=on-failure
RestartSec=15
# The daemon self-idles (retries) until the IPFS node is up, so it's harmless
# when IPFS is disabled; it publishes/merges only public catalog metadata.

[Install]
WantedBy=multi-user.target
