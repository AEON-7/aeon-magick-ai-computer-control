[Unit]
Description=Aeon Magick — Waveshare UPS HAT (E) monitor + low-battery safe-shutdown
# Needs /dev/i2c-1 (i2c-dev module + i2c_arm dtparam, both shipped in the image).
After=systemd-modules-load.service local-fs.target
Wants=systemd-modules-load.service

[Service]
Type=simple
# Tunables default to Waveshare's tested values; override here if your pack or
# shutdown timing differs.
Environment=AEON_UPS_BUS=1
Environment=AEON_UPS_LOW_MV=3150
Environment=AEON_UPS_GRACE_S=60
Environment=AEON_UPS_LOW_PCT=15
# Extra discharge floor (mA magnitude). Pack must be drawing at least this much
# from the cells before a low-battery poweroff can arm — blocks the "battery
# full / trickle (~0 mA) + one corrupt cell read" false positive.
Environment=AEON_UPS_MIN_DISCHARGE_MA=100
# Set to 0 to monitor+publish only (never write 0x55 / never systemctl poweroff).
# Useful to A/B-test unexplained rail-cuts. Re-enable once the pack truly needs
# low-battery protection.
Environment=AEON_UPS_AUTO_POWEROFF=1
# Runs as root: reads I2C 0x2D and may issue `systemctl poweroff` on low batt.
ExecStart=/usr/bin/python3 /usr/local/bin/aeon-ups
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
