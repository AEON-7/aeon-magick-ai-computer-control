[Unit]
Description=Aeon Magick AI Computer Control — adaptive video streamer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aeon-streamer --config /etc/aeon/streamer.toml
Restart=on-failure
RestartSec=2
# Needs read on /dev/video* and write on /run/aeon/
User=aeon
Group=aeon
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target
