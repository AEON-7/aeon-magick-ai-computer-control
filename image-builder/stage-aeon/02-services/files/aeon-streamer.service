[Unit]
Description=Aeon Magick AI Computer Control — adaptive video streamer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Persistent recordings dir must exist + be owned by the service user.
# /var/lib/aeon is root-owned, so the leading `+` runs this as root
# (ignoring User=aeon) to create + chown it before the daemon starts.
ExecStartPre=+/usr/bin/install -d -o aeon -g aeon -m 0755 /var/lib/aeon/recordings
ExecStart=/usr/local/bin/aeon-streamer --config /etc/aeon/streamer.toml
Restart=on-failure
RestartSec=2
# Needs read on /dev/video* and write on /run/aeon/
User=aeon
Group=aeon
SupplementaryGroups=video
# CPU ceiling (defense-in-depth). The shipped ustreamer has no hardware
# JPEG encoder, so the MJPEG path software-encodes; an uncapped 720p60
# stream pegs ~2.3 cores and starves the supervisor (sluggish web UI,
# dropped sessions). The --desired-fps cap (default 30) keeps it near
# ~1 core in normal use, but if someone selects 60fps MJPEG on /system
# this ceiling guarantees the rest of the system stays responsive — the
# stream just drops frames instead of taking the box down. Covers the
# ffmpeg/H.264 child too (same cgroup), where it never bites (HW encode
# is cheap). 200% = 2 of the Pi 4's 4 cores.
CPUQuota=200%

[Install]
WantedBy=multi-user.target
